function calculatePrice(hour) {
    const hourlyRate = 4000;
    const discountedRate = 18000;

    if (hour <= 0) {
        return 0;
    } else if (hour < 5) {
        const totalPrice = hour * hourlyRate;
        return totalPrice;
    } else {
        const discountedHour = Math.floor(hour / 5);
        const modHour = hour % 5;
        const totalPrice = discountedHour * discountedRate + modHour * hourlyRate;
        return totalPrice;
    }
}
